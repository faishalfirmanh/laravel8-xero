{
  "$schema": "https://opencode.ai/config.json",

  "default_agent": "build",
  "snapshot": true,

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },

  "agent": {
    "build": {
      "mode": "primary",
      "prompt": "{file:./.opencode/prompts/build.txt}",
      "permission": {
        "task": "allow",
        "edit": "allow",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git branch*": "allow",
          "git show*": "allow",
          "grep *": "allow",
          "find *": "allow",
          "ls *": "allow",
          "pwd": "allow",
          "php -l *": "allow",
          "php artisan test*": "allow",
          "vendor/bin/phpunit*": "allow",
          "git push*": "deny",
          "git reset*": "deny",
          "git clean*": "deny",
          "php artisan migrate:fresh*": "deny",
          "php artisan db:wipe*": "deny"
        }
      }
    },

    "plan": {
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },

    "analyst": {
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },

    "reviewer": {
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    }
  }
}
